{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry", "repository", "tag", "reference", "digest",
               "mediaType", "manifestBytes", "platforms"],
  "properties": {
    "schema": {"const": "maelys.oci-resolution/v1"},
    "registry": {"type": "string", "description": "Registry authority the tag was read from."},
    "repository": {"type": "string", "description": "Repository the tag belongs to."},
    "tag": {"type": "string", "description": "The mutable tag that was resolved."},
    "reference": {"type": "string", "description": "The REGISTRY/REPOSITORY:TAG reference given."},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$",
               "description": "SHA-256 of the manifest bytes received, computed here and never taken from a header."},
    "mediaType": {"type": "string", "description": "Media type the registry served."},
    "manifestBytes": {"type": "integer", "minimum": 1},
    "platforms": {
      "type": "array",
      "description": "Platforms an index offers; empty for a single-platform manifest.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "digest", "mediaType", "supported"],
        "properties": {
          "platform": {"type": "string", "description": "OS/ARCH of this manifest."},
          "variant": {"type": "string", "description": "Architecture variant when the descriptor names one."},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "mediaType": {"type": "string"},
          "supported": {"type": "boolean",
                        "description": "Whether this materializer accepts that platform."}
        }
      }
    }
  }
}
